<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Row 1: ID, Student Name, Cancel Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_reg_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="#1"
            android:textColor="@color/slate_400"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_reg_student_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Ayush Sachan"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Cancel Registration Button -->
        <TextView
            android:id="@+id/btn_cancel_reg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/rose_300"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_seats_left"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

    <!-- Row 2: Roll Number & Registered Event Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_reg_roll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="26HSB042"
            android:textColor="@color/slate_300"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_card_inner"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_reg_event_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Code Sprint 2.0"
            android:textColor="@color/brand_300"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Row 3: Email & Phone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_reg_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="student@college.edu"
            android:textColor="@color/brand_400"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_reg_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="9876543210"
            android:textColor="@color/slate_400"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Row 4: Registered At Timestamp -->
    <TextView
        android:id="@+id/tv_reg_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Nov 14, 2026 • 10:30 AM"
        android:textColor="@color/slate_500"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

</LinearLayout>
