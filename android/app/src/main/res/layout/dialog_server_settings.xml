<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_modal_sheet"
    android:padding="20dp">

    <!-- Title & Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_settings_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            android:padding="6dp"
            android:background="@drawable/bg_pill_inactive"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_desc"
        android:textColor="@color/slate_400"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="14dp" />

    <!-- Current URL Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FastAPI Backend Base URL:"
        android:textColor="@color/slate_300"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_input"
        android:hint="http://10.0.2.2:8021/"
        android:textColor="@color/white"
        android:textColorHint="@color/slate_500"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:inputType="textUri"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Quick Preset Buttons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Presets:"
        android:textColor="@color/slate_400"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- 24/7 Permanent Cloud URL Preset -->
    <TextView
        android:id="@+id/btn_preset_cloud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="☁️ Permanent Cloud Server (24/7 Online)"
        android:textColor="@color/brand_300"
        android:textStyle="bold"
        android:textSize="12sp"
        android:gravity="center"
        android:background="@drawable/bg_button_gradient"
        android:paddingVertical="9dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_preset_emulator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Emulator (10.0.2.2:8021)"
            android:textColor="@color/slate_200"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_button_secondary"
            android:paddingVertical="8dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_preset_emulator_8082"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Emulator (10.0.2.2:8082)"
            android:textColor="@color/slate_200"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_button_secondary"
            android:paddingVertical="8dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_preset_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📱 Wi-Fi (172.16.53.144:8021)"
            android:textColor="@color/brand_300"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_card_inner"
            android:paddingVertical="8dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_preset_wifi_8082"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📱 Wi-Fi (:8082)"
            android:textColor="@color/brand_300"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_card_inner"
            android:paddingVertical="8dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_preset_localhost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Localhost Loopback (127.0.0.1:8021)"
        android:textColor="@color/slate_300"
        android:textSize="11sp"
        android:gravity="center"
        android:background="@drawable/bg_button_secondary"
        android:paddingVertical="8dp"
        android:layout_marginBottom="14dp" />

    <!-- Test Connection Result Text -->
    <TextView
        android:id="@+id/tv_connection_test_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="@drawable/bg_card_inner"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons: Test Connection & Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_test_connection"
            android:textColor="@color/slate_200"
            android:textSize="12sp"
            android:background="@drawable/bg_button_secondary"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_save_server_settings"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_save_settings"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textAllCaps="false"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
